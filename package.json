{
  "name": "chengyu-storybook",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first Chinese idiom audio storybook for children",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/content-integrity.test.mjs scripts/content-pipeline.test.mjs scripts/release-readiness.test.mjs scripts/spa-shell.test.mjs",
    "test:e2e": "playwright test",
    "content:check": "node scripts/content-report.mjs --check --summary",
    "content:report": "node scripts/content-report.mjs",
    "media:check": "node scripts/media-performance.mjs --check --summary",
    "media:report": "node scripts/media-performance.mjs",
    "narration:plan": "node scripts/narration-plan.mjs --summary",
    "narration:generate": "node scripts/generate-narration.mjs",
    "provenance:check": "node scripts/release-readiness.mjs --check --summary",
    "release:report": "node scripts/release-readiness.mjs --summary",
    "release:check": "node scripts/release-readiness.mjs --release --summary",
    "check": "npm run typecheck && npm test && npm run content:check && npm run provenance:check && npm run media:check && npm run build",
    "deps:inventory": "node scripts/dependency-inventory.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
